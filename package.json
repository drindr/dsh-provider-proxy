{
  "name": "provider-proxy",
  "description": "dsh plugin: per-provider outbound HTTP(S) proxy for LLM providers, with a settings UI. OpenAI official is included as a default disabled rule.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "undici": "^7.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "*"
  },
  "license": "Unlicense",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check lib/index.js && node --test tests/*.test.js"
  }
}
